[Unit]
Description=VisualVibe Agent — Web Desktop (KasmVNC + VS Code + Cline)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/visualvibe-agent:latest
ContainerName=visualvibe-agent

# --- Network: Publish ports to host (8080: Desktop, 8081: FileBrowser) ---
PublishPort=8080:8080
PublishPort=8081:8081

# --- Podman-in-Podman (privileged mode required for nested container runtime) ---
PodmanArgs=--privileged
AddDevice=/dev/fuse

# --- Resource allocation ---
ShmSize=2g

# --- AI Agent Configuration (MANDATORY) ---
# All three variables must be set. The container will abort startup if any are missing.
# URL of the external AI API endpoint (OpenAI-Compatible, e.g. OmniRoute)
Environment=AI_API_URL=

# API Key for the external AI endpoint
Environment=AI_API_KEY=

# Preferred language for Cline (e.g. it, en, es, fr, de, etc.)
Environment=AI_LANG=

# --- Persistent volume for /home/vvagent ---
Volume=visualvibe-home.volume:/home/vvagent

# --- Health check for KasmVNC HTTP server ---
HealthCmd=curl -fsSo /dev/null http://localhost:8080/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=default.target
