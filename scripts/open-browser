#!/bin/bash
# ==============================================================================
# open-browser — Launch or focus Chromium inside VisualVibe Agent desktop
# ==============================================================================
export DISPLAY="${DISPLAY:-:1}"
export XAUTHORITY="${XAUTHORITY:-/home/vvagent/.Xauthority}"

TARGET_URL="${1:-chrome://newtab}"

# 1. If Chromium is already open and no argument provided, raise and focus it
if [ $# -eq 0 ] && wmctrl -l 2>/dev/null | grep -i "Chromium"; then
    wmctrl -a "Chromium" 2>/dev/null || wmctrl -x -a "chromium-browser" 2>/dev/null || true
    exit 0
fi

# 2. Launch Chromium with container-safe flags
CHROMIUM_CMD=(
    /usr/bin/chromium-browser
    --no-sandbox
    --test-type
    --no-first-run
    --no-default-browser-check
    --disable-dev-shm-usage
    --disable-gpu
    --password-store=basic
    --start-maximized
    "$TARGET_URL"
)

if [ "$(id -u)" -eq 0 ]; then
    runuser -u vvagent -- "${CHROMIUM_CMD[@]}" >/dev/null 2>&1 &
else
    "${CHROMIUM_CMD[@]}" >/dev/null 2>&1 &
fi

# 3. Ensure window is maximized once mapped by window manager
(
    for _i in {1..20}; do
        if wmctrl -l 2>/dev/null | grep -i "Chromium"; then
            sleep 0.5
            wmctrl -r "Chromium" -b add,maximized_vert,maximized_horz 2>/dev/null || true
            break
        fi
        sleep 0.3
    done
) &
